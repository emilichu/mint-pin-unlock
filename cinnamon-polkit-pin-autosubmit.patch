 const MAX_MODAL_RETRIES = 2;
 
+let _cachedPinLength = -1;
+
+// Reads /etc/pin-unlock/length on first call and caches it. Returns the
+// positive integer length, or 0 if no PIN length is configured (or the file
+// is invalid). Same path is used by the cinnamon-screensaver and
+// slick-greeter patches so all three share one config.
+function _getPinLength() {
+    if (_cachedPinLength >= 0)
+        return _cachedPinLength;
+    _cachedPinLength = 0;
+    try {
+        let [ok, contents] = GLib.file_get_contents('/etc/pin-unlock/length');
+        if (ok) {
+            let n = parseInt(imports.byteArray.toString(contents).trim(), 10);
+            if (n > 0)
+                _cachedPinLength = n;
+        }
+    } catch (e) {
+        // No PIN configured -- auto-submit stays disabled.
+    }
+    return _cachedPinLength;
+}
